# Configuration locale de l'application (version autonome, sans Zite).
#
# Le SDK `zitejs/upload` combine VITE_ZITE_API_URL avec ses routes d'envoi de
# fichiers. On le pointe vers notre propre serveur (/api), servi par Express en
# production et relayé par le proxy Vite en développement.
VITE_ZITE_API_URL=/api

# Identifiant du projet Zite d'origine, conservé pour la traçabilité.
VITE_ZITE_FLOW_ID=ip2kuase4w
