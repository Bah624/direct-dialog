# Copier en `.env` à la racine puis renseigner la clé si l'on veut utiliser
# la page « Agent IA Vocal » (Whisper + chat + synthèse vocale).
# Sans clé, le reste de l'application fonctionne normalement.

ZITE_OPENAI_ACCESS_TOKEN=

# Mot de passe initial du compte administrateur (créé au premier démarrage).
# Laissez vide pour générer un mot de passe aléatoire (affiché dans les logs).
ADMIN_PASSWORD=
